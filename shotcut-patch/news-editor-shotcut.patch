+// 샷 하나의 자동 분석 결과. 분석은 모두 저해상도 프록시/모노 음성 파일로 한다.
+struct ShotAnalysis
+{
+    bool done = false;
+
+    // 싱크/스케치: 채널1 음성 구간
+    double voicedSeconds = 0.0;
+    double voicedRatio = 0.0;
+    double ch1RmsDb = -100.0;
+    bool isSync = false;
+
+    // 흔들림 컷 (프레임, 29.97 기준)
+    int trimHead = 0;
+    int trimTail = 0;
+
+    // 자동 화이트밸런스: 중성이어야 할 색(그레이월드 평균). valid=false면 보정 불필요
+    bool wbNeeded = false;
+    QColor wbNeutral = QColor(127, 127, 127);
+
+    // 인물 부분 노출: 화면 중앙 피사체가 배경보다 어두울 때만
+    bool exposureNeeded = false;
+    QRectF subjectRect; // 0~1 정규화 좌표
+    double exposureGamma = 1.0;
+    double subjectLuma = 0.0;
+    double backgroundLuma = 0.0;
+};
+
+class NewsAnalyzer
+{
+public:
+    static QString ffmpegPath();
+
+    // 채널1(모노 MXF)의 음성 구간으로 싱크 여부를 판단한다.
+    static void analyzeSpeech(const QString &ch1Path, double shotSeconds, ShotAnalysis &out);
+    // 프록시의 프레임 간 차이로 녹화 시작/끝 흔들림 구간을 찾는다. (4초 이상 스케치만)
+    static void analyzeShake(const QString &proxyPath, int shotFrames, ShotAnalysis &out);
+    // 프록시 몇 프레임을 샘플링해 화이트밸런스와 인물 노출을 분석한다.
+    static void analyzeColor(const QString &proxyPath, double shotSeconds, ShotAnalysis &out);
+
+    // 순수 계산 부분 (테스트하기 쉽게 분리)
+    // headMotion: 앞 2초의 프레임 간 차이, tailMotion: 끝 2초 (시간 순서 그대로)
+    static void computeTrim(const QVector<float> &headMotion,
+                            const QVector<float> &tailMotion,
+                            int shotFrames,
+                            int &head,
+                            int &tail);
+
+private:
+    static QByteArray run(const QStringList &args, int timeoutMs, bool stdoutOnly);
+};
