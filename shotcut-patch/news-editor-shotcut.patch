+#ifndef P2CARD_H
+#define P2CARD_H
+
+#include <QDateTime>
+#include <QList>
+#include <QString>
+#include <QStringList>
+
+// P2 카드 한 조각(클립 XML 하나)
+struct P2ClipPart
+{
+    QString name;      // 예: 0011UY
+    int frames = 0;    // 29.97 기준 프레임 수
+    int audioCount = 0;
+};
+
+// 연결 클립을 하나로 묶은 촬영 단위(샷)
+struct P2Shot
+{
+    QList<P2ClipPart> parts;
+    QString codec;
+    QString startTimecode;
+    QDateTime shootStart;
+    QString model;
+    bool continuesOnOtherCard = false;
+
+    QString name() const { return parts.isEmpty() ? QString() : parts.first().name; }
+    QString label() const;
+    int frames() const;
+    int audioChannels() const;
+    double seconds() const { return frames() * 1001.0 / 30000.0; }
+};
+
+class P2Card
+{
+public:
+    // contentsDir: P2 카드의 CONTENTS 폴더
+    bool load(const QString &contentsDir, QString *error = nullptr);
+
+    const QList<P2Shot> &shots() const { return m_shots; }
+    QString contentsDir() const { return m_contentsDir; }
+
+    QString videoPath(const QString &clipName) const;
+    QString audioPath(const QString &clipName, int channel) const;
+    QString proxyPath(const QString &clipName) const;
+    QString iconPath(const QString &clipName) const;
+
+    // 영상 + 채널별 음성 + 연결 클립을 하나로 묶은 MLT XML을 만든다.
+    // ch1 → 왼쪽, ch2 → 오른쪽, ch3·4는 기본 음소거.
+    QString shotXml(const P2Shot &shot) const;
+    QString writeShotMlt(const P2Shot &shot, const QString &outDir) const;
+
+    static QString defaultContentsDir();
+
+private:
+    QString m_contentsDir;
+    QList<P2Shot> m_shots;
+};
+
+#endif // P2CARD_H
