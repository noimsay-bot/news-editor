+
+#include "p2card.h"
+
+#include <QDir>
+#include <QDomDocument>
+#include <QFile>
+#include <QFileInfo>
+#include <QHash>
+#include <QObject>
+#include <QStorageInfo>
+
+#include <algorithm>
+#include <utility>
+
+namespace {
+
+struct ClipInfo
+{
+    P2ClipPart part;
+    QString codec;
+    QString startTc;
+    QDateTime shootStart;
+    QString model;
+    QString top;
+    QString next;
+};
+
+QDomElement child(const QDomElement &e, const QString &name)
+{
+    return e.isNull() ? QDomElement() : e.firstChildElement(name);
+}
+
+QString findFile(const QString &dir, const QString &fileName)
+{
+    // P2 카드는 대문자 파일명이지만 복사본은 소문자일 수 있다.
+    QDir d(dir);
+    if (d.exists(fileName))
+        return d.absoluteFilePath(fileName);
+    const auto entries = d.entryList({fileName}, QDir::Files, QDir::NoSort);
+    for (const auto &e : entries) {
+        if (e.compare(fileName, Qt::CaseInsensitive) == 0)
+            return d.absoluteFilePath(e);
+    }
+    return d.absoluteFilePath(fileName);
+}
+
+QString escapeXml(const QString &s)
+{
+    return s.toHtmlEscaped();
+}
+
+} // namespace
+
+QString P2Shot::label() const
+{
+    QStringList names;
+    for (const auto &p : parts)
+        names << p.name;
+    return names.join('+');
+}
+
+int P2Shot::frames() const
+{
+    int total = 0;
+    for (const auto &p : parts)
+        total += p.frames;
+    return total;
+}
+
+int P2Shot::audioChannels() const
+{
+    int n = 99;
+    for (const auto &p : parts)
+        n = std::min(n, p.audioCount);
+    return parts.isEmpty() ? 0 : n;
+}
+
+bool P2Card::load(const QString &contentsDir, QString *error)
+{
+    m_shots.clear();
+    m_contentsDir = QDir(contentsDir).absolutePath();
+    QDir clipDir(m_contentsDir + "/CLIP");
+    if (!clipDir.exists()) {
+        if (error)
+            *error = QObject::tr("CLIP 폴더가 없습니다. P2 카드의 CONTENTS 폴더를 선택하세요.");
+        return false;
+    }
+
+    QHash<QString, ClipInfo> clips;
+    const auto files = clipDir.entryList({"*.XML", "*.xml"}, QDir::Files, QDir::Name);
+    for (const auto &f : files) {
+        QFile file(clipDir.absoluteFilePath(f));
+        if (!file.open(QIODevice::ReadOnly))
+            continue;
+        QDomDocument doc;
+        if (!doc.setContent(&file))
+            continue;
+        auto content = child(doc.documentElement(), "ClipContent");
+        if (content.isNull())
+            continue;
+        ClipInfo info;
+        info.part.name = child(content, "ClipName").text();
+        info.part.frames = child(content, "Duration").text().toInt();
+        auto essence = child(content, "EssenceList");
+        auto video = child(essence, "Video");
+        info.codec = child(video, "Codec").text();
+        info.startTc = child(video, "StartTimecode").text();
+        for (auto a = child(essence, "Audio"); !a.isNull(); a = a.nextSiblingElement("Audio"))
+            info.part.audioCount++;
+        auto meta = child(content, "ClipMetadata");
+        info.model = child(child(meta, "Device"), "ModelName").text();
+        info.shootStart = QDateTime::fromString(child(child(meta, "Shoot"), "StartDate").text(),
+                                                Qt::ISODate);
+        auto conn = child(child(content, "Relation"), "Connection");
+        info.top = conn.isNull() ? info.part.name : child(child(conn, "Top"), "ClipName").text();
+        info.next = child(child(conn, "Next"), "ClipName").text();
+        if (info.part.name.isEmpty() || info.part.frames <= 0)
+            continue;
+        clips.insert(info.part.name, info);
+    }
+
+    // 연결 클립은 첫 조각(Top)에서 Next를 따라가며 하나로 묶는다.
+    for (const auto &c : std::as_const(clips)) {
+        if (c.top != c.part.name)
+            continue;
+        P2Shot shot;
+        shot.codec = c.codec;
+        shot.startTimecode = c.startTc;
+        shot.shootStart = c.shootStart;
+        shot.model = c.model;
+        shot.parts << c.part;
+        const ClipInfo *cur = &c;
+        while (!cur->next.isEmpty() && clips.contains(cur->next)) {
+            cur = &clips[cur->next];
+            shot.parts << cur->part;
+        }
+        shot.continuesOnOtherCard = !cur->next.isEmpty();
+        m_shots << shot;
+    }
+    std::sort(m_shots.begin(), m_shots.end(), [](const P2Shot &a, const P2Shot &b) {
+        if (a.shootStart != b.shootStart)
+            return a.shootStart < b.shootStart;
+        return a.name() < b.name();
+    });
+    if (m_shots.isEmpty() && error)
+        *error = QObject::tr("클립을 찾지 못했습니다.");
+    return !m_shots.isEmpty();
+}
+
+QString P2Card::videoPath(const QString &clipName) const
+{
+    return findFile(m_contentsDir + "/VIDEO", clipName + ".MXF");
+}
+
+QString P2Card::audioPath(const QString &clipName, int channel) const
+{
+    return findFile(m_contentsDir + "/AUDIO",
+                    QStringLiteral("%1%2.MXF").arg(clipName).arg(channel, 2, 10, QChar('0')));
+}
+
+QString P2Card::proxyPath(const QString &clipName) const
+{
+    return findFile(m_contentsDir + "/PROXY", clipName + ".MOV");
+}
+
+QString P2Card::iconPath(const QString &clipName) const
+{
+    return findFile(m_contentsDir + "/ICON", clipName + ".BMP");
+}
+
+QString P2Card::shotXml(const P2Shot &shot) const
+{
+    const int total = shot.frames();
+    const int channels = shot.audioChannels();
+    QString x;
+    x += "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n";
+    x += "<mlt LC_NUMERIC=\"C\" version=\"7.0.0\">\n";
+    // AVC-I 1080/59.94i: 29.97 프레임, 인터레이스, 16:9 (AVC-I 50은 1440x1080 SAR 4:3)
+    x += "  <profile description=\"HD 1080i 29.97 fps\" width=\"1920\" height=\"1080\" "
+         "progressive=\"0\" sample_aspect_num=\"1\" sample_aspect_den=\"1\" "
+         "display_aspect_num=\"16\" display_aspect_den=\"9\" frame_rate_num=\"30000\" "
+         "frame_rate_den=\"1001\" colorspace=\"709\"/>\n";
+
+    QStringList playlists;
+    auto addTrack = [&](const QString &id, int channel) {
+        QString entries;
+        for (int i = 0; i < shot.parts.size(); i++) {
+            const auto &p = shot.parts[i];
+            const QString pid = QStringLiteral("%1_%2").arg(id).arg(i);
+            const QString file = channel < 0 ? videoPath(p.name) : audioPath(p.name, channel);
+            x += QStringLiteral("  <producer id=\"%1\" in=\"0\" out=\"%2\">\n").arg(pid).arg(p.frames - 1);
+            x += QStringLiteral("    <property name=\"length\">%1</property>\n").arg(p.frames);
+            x += QStringLiteral("    <property name=\"resource\">%1</property>\n")
+                     .arg(escapeXml(QDir::fromNativeSeparators(file)));
+            x += "    <property name=\"mlt_service\">avformat</property>\n";
+            if (channel < 0) {
+                x += "    <property name=\"audio_index\">-1</property>\n";
+            } else {
+                x += "    <property name=\"video_index\">-1</property>\n";
+                // ch1 → 왼쪽, ch2 → 오른쪽. 모노 원본이 스테레오로 복제되므로 밸런스로 한쪽만 남긴다.
+                // tractor 필터로 걸면 mix 이후에 적용되므로 producer 안에 둔다.
+                // panner의 split은 애니메이션 속성이라 길이 없이 쓰면 무시된다 → start 사용.
+                if (channel <= 1) {
+                    x += "    <filter mlt_service=\"panner\">\n";
+                    x += "      <property name=\"channel\">-1</property>\n";
+                    x += QStringLiteral("      <property name=\"start\">%1</property>\n").arg(channel);
+                    x += "    </filter>\n";
+                    // mix 트랜지션이 입력마다 -3dB를 걸므로 원본 레벨로 보정 (실측 확인)
+                    x += "    <filter mlt_service=\"volume\">\n";
+                    x += "      <property name=\"level\">3.0103</property>\n";
+                    x += "    </filter>\n";
+                }
+            }
+            x += "  </producer>\n";
+            entries += QStringLiteral("    <entry producer=\"%1\" in=\"0\" out=\"%2\"/>\n")
+                           .arg(pid)
+                           .arg(p.frames - 1);
+        }
+        x += QStringLiteral("  <playlist id=\"%1\">\n").arg(id) + entries + "  </playlist>\n";
+        playlists << id;
+    };
+
+    addTrack("video", -1);
+    for (int ch = 0; ch < channels; ch++)
+        addTrack(QStringLiteral("ch%1").arg(ch + 1), ch);
+
+    x += QStringLiteral("  <tractor id=\"tractor0\" in=\"0\" out=\"%1\">\n").arg(total - 1);
+    x += QStringLiteral("    <property name=\"news:p2clip\">%1</property>\n").arg(shot.label());
+    x += QStringLiteral("    <property name=\"news:startTimecode\">%1</property>\n").arg(shot.startTimecode);
+    for (int i = 0; i < playlists.size(); i++) {
+        const bool hideAudio = (i == 0 || i >= 3);
+        x += QStringLiteral("    <track producer=\"%1\"%2/>\n")
+                 .arg(playlists[i], hideAudio ? " hide=\"audio\"" : "");
+    }
+    for (int i = 1; i < playlists.size(); i++) {
+        x += "    <transition mlt_service=\"mix\">\n";
+        x += "      <property name=\"a_track\">0</property>\n";
+        x += QStringLiteral("      <property name=\"b_track\">%1</property>\n").arg(i);
+        x += "      <property name=\"sum\">1</property>\n";
+        x += "      <property name=\"always_active\">1</property>\n";
+        x += "    </transition>\n";
+    }
+    x += "  </tractor>\n</mlt>\n";
+    return x;
+}
+
+QString P2Card::writeShotMlt(const P2Shot &shot, const QString &outDir) const
+{
+    QDir().mkpath(outDir);
+    const QString path = QDir(outDir).absoluteFilePath(shot.name() + ".mlt");
+    QFile f(path);
+    if (!f.open(QIODevice::WriteOnly | QIODevice::Truncate))
+        return QString();
+    f.write(shotXml(shot).toUtf8());
+    return path;
+}
+
+QString P2Card::defaultContentsDir()
+{
+    // 이동식 디스크 중 CONTENTS/CLIP이 있는 첫 드라이브
+    for (const auto &vol : QStorageInfo::mountedVolumes()) {
+        const QString dir = QDir(vol.rootPath()).absoluteFilePath("CONTENTS");
+        if (QFileInfo::exists(dir + "/CLIP"))
+            return dir;
+    }
+    return QStringLiteral("E:/CONTENTS");
+}
