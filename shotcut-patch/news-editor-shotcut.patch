+bool EncodeDock::exportNewsXdcam(const QString &target)
+{
+    if (!MLT.producer() || !m_presets || !m_presets->is_valid() || target.isEmpty())
+        return false;
+    // EDIUS JTBC 프리셋과 같은 규격: XDCAM HD422, MPEG-2 50Mbps CBR, MXF, 1080i TFF, PCM 16bit 2ch
+    Mlt::Properties preset((mlt_properties) m_presets->get_data("consumer/avformat/XDCAM-HD422"));
+    if (!preset.is_valid())
+        return false;
+    resetOptions();
+    setResolutionAspectFromProfile();
+    ui->scanModeCombo->setCurrentIndex(0);
+    on_scanModeCombo_currentIndexChanged(0);
+    loadPresetFromProperties(preset);
+    ui->fieldOrderCombo->setCurrentIndex(1);
+    setAudioChannels(2);
+    const int fromIndex = ui->fromCombo->findData("timeline");
+    if (fromIndex < 0)
+        return false;
+    ui->fromCombo->setCurrentIndex(fromIndex);
+    if (checkForMissingFiles())
+        return false;
+
+    MLT.pause();
+    m_outputFilenames = QStringList(target);
+    Settings.setEncodePath(QFileInfo(target).path());
+    MLT.purgeMemoryPool();
+    int threadCount = QThread::idealThreadCount();
+    threadCount = threadCount > 2 ? qMin(threadCount - 1, 4) : 1;
+    enqueueAnalysis();
+    enqueueMelt(m_outputFilenames, Settings.playerGPU() ? -1 : -threadCount);
+    return true;
+}
