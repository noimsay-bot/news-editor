+// ---------------------------------------------------------------- 자동 분석
+
+void NewsDock::setBusy(bool busy, const QString &message)
+{
+    m_busy = busy;
+    m_loadButton->setEnabled(!busy);
+    m_analyzeButton->setEnabled(!busy && !m_card.shots().isEmpty());
+    m_arrangeButton->setEnabled(!busy && !m_card.shots().isEmpty());
+    m_exportButton->setEnabled(!busy);
+    m_progress->setVisible(busy);
+    if (!message.isEmpty())
+        m_status->setText(message);
+}
+
+ShotAnalysis NewsDock::computeShot(int index) const
+{
+    const auto &shot = m_card.shots().at(index);
+    ShotAnalysis a;
+    // 음성: 연결 클립이면 첫 조각의 채널1로 판단
+    NewsAnalyzer::analyzeSpeech(m_card.audioPath(shot.name(), 0), shot.parts.first().frames * 1001.0 / 30000.0, a);
+    // 흔들림·색: 프록시 (640x360)로 분석. 연결 클립은 앞 조각의 앞부분, 끝 조각의 끝부분
+    if (shot.parts.size() == 1) {
+        NewsAnalyzer::analyzeShake(m_card.proxyPath(shot.name()), shot.frames(), a);
+    } else {
+        ShotAnalysis headOnly, tailOnly;
+        NewsAnalyzer::analyzeShake(m_card.proxyPath(shot.parts.first().name), shot.frames(), headOnly);
+        NewsAnalyzer::analyzeShake(m_card.proxyPath(shot.parts.last().name), shot.frames(), tailOnly);
+        a.trimHead = headOnly.trimHead;
+        a.trimTail = tailOnly.trimTail;
+    }
+    NewsAnalyzer::analyzeColor(m_card.proxyPath(shot.name()), shot.parts.first().frames * 1001.0 / 30000.0, a);
+    a.done = true;
+    return a;
+}
+
+void NewsDock::onAnalyze()
+{
+    if (m_busy || m_card.shots().isEmpty())
+        return;
+    const int n = m_card.shots().size();
+    setBusy(true, tr("분석 중… 프록시와 채널1 음성으로 분석하므로 원본보다 훨씬 빠릅니다."));
+    m_progress->setRange(0, n);
+    m_progress->setValue(0);
+    m_pending.storeRelease(n);
+    auto pool = QThreadPool::globalInstance();
+    pool->setMaxThreadCount(std::max(pool->maxThreadCount(), kAnalysisThreads));
+    QPointer<NewsDock> self(this);
+    // 결과는 미리 잡아둔 칸에 직접 쓴다 (작업 중 m_analysis 크기는 바뀌지 않음)
+    ShotAnalysis *results = m_analysis.data();
+    for (int i = 0; i < n; i++) {
+        pool->start([self, results, i]() {
+            if (!self)
+                return;
+            results[i] = self->computeShot(i);
+            QMetaObject::invokeMethod(self, "onShotAnalyzed", Qt::QueuedConnection, Q_ARG(int, i));
+        });
+    }
+}
+
+void NewsDock::analyzeAllBlocking()
+{
+    for (int i = 0; i < m_card.shots().size(); i++) {
+        m_analysis[i] = computeShot(i);
+        refreshRow(i);
+    }
+}
+
+void NewsDock::onShotAnalyzed(int index)
+{
+    refreshRow(index);
+    m_progress->setValue(m_progress->value() + 1);
+    if (m_pending.fetchAndAddOrdered(-1) == 1) {
+        int sync = 0, trimmed = 0, wb = 0, exposure = 0;
+        for (int i = 0; i < m_analysis.size(); i++) {
+            sync += isSync(i);
+            trimmed += (m_analysis[i].trimHead || m_analysis[i].trimTail) && !isSync(i);
+            wb += m_analysis[i].wbNeeded;
+            exposure += m_analysis[i].exposureNeeded;
+        }
+        setBusy(false,
+                tr("분석 완료 · 싱크 %1 · 스케치 %2 · 흔들림 컷 %3 · WB %4 · 역광 인물 %5. "
+                   "분류가 틀리면 분류 칸을 클릭해 바꾸세요.")
+                    .arg(sync)
+                    .arg(m_analysis.size() - sync)
+                    .arg(trimmed)
+                    .arg(wb)
+                    .arg(exposure));
+    }
+}
+
+// ---------------------------------------------------------------- 타임라인 정렬
+
+QString NewsDock::clipFiltersXml(int index) const
+{
+    const auto &a = m_analysis[index];
+    QString x;
+    if (!a.done)
+        return x;
+    if (m_wbCheck->isChecked() && a.wbNeeded) {
+        x += "    <filter mlt_service=\"frei0r.colgate\">\n";
+        x += QStringLiteral("      <property name=\"0\">%1</property>\n").arg(a.wbNeutral.name());
+        x += "      <property name=\"1\">0.433333</property>\n"; // 6500K
+        x += "      <property name=\"threads\">0</property>\n";
+        x += "      <property name=\"news:auto\">wb</property>\n";
+        x += "    </filter>\n";
+    }
+    if (m_exposureCheck->isChecked() && a.exposureNeeded) {
+        // 마스크(타원, 부드러운 경계) 안에서만 감마를 올린다 → 배경 노출 유지
+        const QRectF r = a.subjectRect;
+        x += "    <filter mlt_service=\"mask_start\">\n";
+        x += "      <property name=\"shotcut:filter\">maskSimpleShape</property>\n";
+        x += "      <property name=\"filter\">frei0r.alphaspot</property>\n";
+        x += "      <property name=\"filter.0\">0.333333</property>\n"; // 타원
+        x += QStringLiteral("      <property name=\"filter.1\">%1</property>\n").arg(r.center().x(), 0, 'f', 4);
+        x += QStringLiteral("      <property name=\"filter.2\">%1</property>\n").arg(r.center().y(), 0, 'f', 4);
+        x += QStringLiteral("      <property name=\"filter.3\">%1</property>\n").arg(r.width() / 2, 0, 'f', 4);
+        x += QStringLiteral("      <property name=\"filter.4\">%1</property>\n").arg(r.height() / 2, 0, 'f', 4);
+        x += "      <property name=\"filter.5\">0.5</property>\n";
+        x += "      <property name=\"filter.6\">0.45</property>\n"; // 경계 부드럽게
+        x += "      <property name=\"filter.9\">0</property>\n";
+        x += QStringLiteral("      <property name=\"shotcut:rect\">%1%/%2%:%3%x%4%</property>\n")
+                 .arg(r.x() * 100, 0, 'f', 2)
+                 .arg(r.y() * 100, 0, 'f', 2)
+                 .arg(r.width() * 100, 0, 'f', 2)
+                 .arg(r.height() * 100, 0, 'f', 2);
+        x += "      <property name=\"news:auto\">exposure</property>\n";
+        x += "    </filter>\n";
+        x += "    <filter mlt_service=\"lift_gamma_gain\">\n";
+        for (const QString c : {QStringLiteral("r"), QStringLiteral("g"), QStringLiteral("b")}) {
+            x += QStringLiteral("      <property name=\"lift_%1\">0</property>\n").arg(c);
+            x += QStringLiteral("      <property name=\"gamma_%1\">%2</property>\n").arg(c).arg(a.exposureGamma, 0, 'f', 3);
+            x += QStringLiteral("      <property name=\"gain_%1\">1</property>\n").arg(c);
+        }
+        x += "      <property name=\"shotcut:filter_version\">1</property>\n";
+        x += "      <property name=\"news:auto\">exposure</property>\n";
+        x += "    </filter>\n";
+        x += "    <filter mlt_service=\"mask_apply\">\n";
+        x += "      <property name=\"transition\">qtblend</property>\n";
+        x += "      <property name=\"transition.threads\">0</property>\n";
+        x += "      <property name=\"news:auto\">exposure</property>\n";
+        x += "    </filter>\n";
+    }
+    if (m_noiseCheck->isChecked() && isSync(index)) {
+        x += "    <filter mlt_service=\"rnnoise\">\n";
+        x += "      <property name=\"mix\">1</property>\n";
+        x += "      <property name=\"news:auto\">noise</property>\n";
+        x += "    </filter>\n";
+    }
+    return x;
+}
+
+QString NewsDock::buildProjectFile()
+{
+    const auto &shots = m_card.shots();
+    QList<int> syncList, sketchList;
+    for (int i = 0; i < shots.size(); i++) {
+        auto item = m_tree->topLevelItem(i);
+        if (item && item->checkState(ColName) != Qt::Checked)
+            continue;
+        (isSync(i) ? syncList : sketchList) << i;
+    }
+    if (syncList.isEmpty() && sketchList.isEmpty())
+        return QString();
+
+    // 클립 in/out (스케치 4초 이상만 흔들림 컷)
+    auto clipRange = [&](int i, int &in, int &out) {
+        const int frames = shots[i].frames();
+        in = 0;
+        out = frames - 1;
+        if (m_shakeCheck->isChecked() && !isSync(i) && m_analysis[i].done) {
+            in = m_analysis[i].trimHead;
+            out = frames - 1 - m_analysis[i].trimTail;
+        }
+    };
+    int syncLen = 0, sketchLen = 0;
+    for (int i : syncList) {
+        int in, out;
+        clipRange(i, in, out);
+        syncLen += out - in + 1;
+    }
+    for (int i : sketchList) {
+        int in, out;
+        clipRange(i, in, out);
+        sketchLen += out - in + 1;
+    }
+    const int total = syncLen + sketchLen;
+
+    QString x;
+    x += "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n";
+    x += "<mlt LC_NUMERIC=\"C\" version=\"7.40.0\" title=\"뉴스 원본 편집기\" producer=\"main_bin\">\n";
+    x += "  <profile description=\"HD 1080i 29.97 fps\" width=\"1920\" height=\"1080\" progressive=\"0\" "
+         "sample_aspect_num=\"1\" sample_aspect_den=\"1\" display_aspect_num=\"16\" display_aspect_den=\"9\" "
+         "frame_rate_num=\"30000\" frame_rate_den=\"1001\" colorspace=\"709\"/>\n";
+    x += "  <playlist id=\"main_bin\">\n    <property name=\"xml_retain\">1</property>\n";
+    x += "  </playlist>\n";
+    x += QStringLiteral("  <producer id=\"black\" in=\"0\" out=\"%1\">\n").arg(total - 1);
+    x += QStringLiteral("    <property name=\"length\">%1</property>\n").arg(total);
+    x += "    <property name=\"eof\">pause</property>\n";
+    x += "    <property name=\"resource\">0</property>\n";
+    x += "    <property name=\"aspect_ratio\">1</property>\n";
+    x += "    <property name=\"mlt_service\">color</property>\n";
+    x += "    <property name=\"mlt_image_format\">rgba</property>\n";
+    x += "    <property name=\"set.test_audio\">0</property>\n";
+    x += "  </producer>\n";
+    x += QStringLiteral("  <playlist id=\"background\">\n    <entry producer=\"black\" in=\"0\" out=\"%1\"/>\n  </playlist>\n")
+             .arg(total - 1);
+
+    // V1 = 싱크 (0부터), V2 = 스케치 (싱크가 끝난 뒤부터) → 재생하면 싱크 → 스케치 순으로 다 보인다.
+    auto writeTrack = [&](const QString &id, const QString &name, const QList<int> &list, int startBlank) {
+        QString entries;
+        if (startBlank > 0)
+            entries += QStringLiteral("    <blank length=\"%1\"/>\n").arg(startBlank);
+        for (int i : list) {
+            const auto &shot = shots[i];
+            const QString pid = QStringLiteral("clip_%1").arg(shot.name());
+            int in, out;
+            clipRange(i, in, out);
+            x += QStringLiteral("  <producer id=\"%1\" in=\"0\" out=\"%2\">\n").arg(pid).arg(shot.frames() - 1);
+            x += QStringLiteral("    <property name=\"length\">%1</property>\n").arg(shot.frames());
+            x += QStringLiteral("    <property name=\"resource\">%1</property>\n")
+                     .arg(esc(QDir::fromNativeSeparators(shotMltPath(i))));
+            x += "    <property name=\"mlt_service\">xml</property>\n";
+            x += QStringLiteral("    <property name=\"shotcut:caption\">%1 %2</property>\n")
+                     .arg(isSync(i) ? tr("싱크") : tr("스케치"), shot.label());
+            x += clipFiltersXml(i);
+            x += "  </producer>\n";
+            entries += QStringLiteral("    <entry producer=\"%1\" in=\"%2\" out=\"%3\"/>\n").arg(pid).arg(in).arg(out);
+        }
+        x += QStringLiteral("  <playlist id=\"%1\">\n").arg(id);
+        x += "    <property name=\"shotcut:video\">1</property>\n";
+        x += QStringLiteral("    <property name=\"shotcut:name\">%1</property>\n").arg(name);
+        x += entries + "  </playlist>\n";
+    };
+    writeTrack("playlist0", tr("V1 싱크"), syncList, 0);
+    writeTrack("playlist1", tr("V2 스케치"), sketchList, syncLen);
+
+    x += QStringLiteral("  <tractor id=\"tractor0\" title=\"뉴스 원본 편집기\" in=\"0\" out=\"%1\">\n").arg(total - 1);
+    x += "    <property name=\"shotcut\">1</property>\n";
+    x += "    <property name=\"shotcut:projectAudioChannels\">2</property>\n";
+    x += "    <track producer=\"background\"/>\n";
+    x += "    <track producer=\"playlist0\"/>\n";
+    x += "    <track producer=\"playlist1\"/>\n";
+    for (int b : {1, 2}) {
+        x += "    <transition mlt_service=\"mix\">\n";
+        x += "      <property name=\"a_track\">0</property>\n";
+        x += QStringLiteral("      <property name=\"b_track\">%1</property>\n").arg(b);
+        x += "      <property name=\"always_active\">1</property>\n";
+        x += "      <property name=\"sum\">1</property>\n";
+        x += "    </transition>\n";
+    }
+    x += "    <transition mlt_service=\"qtblend\">\n";
+    x += "      <property name=\"a_track\">1</property>\n";
+    x += "      <property name=\"b_track\">2</property>\n";
+    x += "      <property name=\"compositing\">0</property>\n";
+    x += "      <property name=\"distort\">0</property>\n";
+    x += "      <property name=\"threads\">0</property>\n";
+    x += "    </transition>\n";
+    x += "  </tractor>\n</mlt>\n";
+
+    const QString path = QDir(workDir()).absoluteFilePath(
+        QStringLiteral("타임라인_%1.mlt").arg(QDateTime::currentDateTime().toString("yyyyMMdd_HHmmss")));
+    QDir().mkpath(workDir());
+    QFile f(path);
+    if (!f.open(QIODevice::WriteOnly | QIODevice::Truncate))
+        return QString();
+    f.write(x.toUtf8());
+    return path;
+}
+
+void NewsDock::onArrange()
+{
+    if (m_busy || m_card.shots().isEmpty())
+        return;
+    bool analyzed = std::any_of(m_analysis.cbegin(), m_analysis.cend(), [](const ShotAnalysis &a) {
+        return a.done;
+    });
+    if (!analyzed) {
+        auto answer = QMessageBox::question(this,
+                                            tr("자동 분석"),
+                                            tr("아직 분석하지 않았습니다. 분석 없이 모두 스케치로 배치할까요?\n"
+                                               "(아니요를 누르면 먼저 자동 분석을 하세요)"));
+        if (answer != QMessageBox::Yes)
+            return;
+    }
+    const QString path = buildProjectFile();
+    if (path.isEmpty()) {
+        m_status->setText(tr("배치할 클립이 없습니다."));
+        return;
+    }
+    LOG_INFO() << "news project" << path;
+    if (MAIN.open(path))
+        m_status->setText(tr("타임라인 구성 완료: V1 싱크 → V2 스케치 순서로 이어집니다. 자동 보정은 필터 패널에서 켜고 끌 수 있습니다."));
+}
+
+// ---------------------------------------------------------------- 출력
+
+void NewsDock::onExport()
+{
+    if (!MAIN.isMultitrackValid()) {
+        QMessageBox::information(this, tr("출력"), tr("먼저 타임라인을 구성하세요."));
+        return;
+    }
+    QDir dir(m_outDirEdit->text());
+    if (!dir.exists() && !QDir().mkpath(dir.absolutePath())) {
+        QMessageBox::warning(this, tr("출력"), tr("저장 위치를 만들 수 없습니다."));
+        return;
+    }
+    QString target = dir.absoluteFilePath(outputBaseName() + ".mxf");
+    if (QFileInfo::exists(target)) {
+        auto answer = QMessageBox::question(this, tr("출력"), tr("같은 이름의 파일이 있습니다. 덮어쓸까요?\n%1").arg(target));
+        if (answer != QMessageBox::Yes)
+            return;
+    }
+    if (MAIN.encodeDock()->exportNewsXdcam(target))
+        m_status->setText(tr("출력 시작: %1 (작업 패널에서 진행률 확인)").arg(QDir::toNativeSeparators(target)));
+    else
+        QMessageBox::warning(this, tr("출력"), tr("출력을 시작하지 못했습니다."));
+}
