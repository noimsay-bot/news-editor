+QFrame *makeCard(QWidget *parent, const QString &step, const QString &title, QVBoxLayout **body)
+{
+    auto card = new QFrame(parent);
+    card->setObjectName("NewsCard");
+    auto v = new QVBoxLayout(card);
+    v->setContentsMargins(12, 10, 12, 12);
+    v->setSpacing(8);
+    auto head = new QHBoxLayout;
+    auto stepLabel = new QLabel(step, card);
+    stepLabel->setObjectName("NewsStep");
+    auto titleLabel = new QLabel(title, card);
+    titleLabel->setObjectName("NewsTitle");
+    head->addWidget(stepLabel);
+    head->addWidget(titleLabel);
+    head->addStretch();
+    v->addLayout(head);
+    *body = v;
+    return card;
+}
