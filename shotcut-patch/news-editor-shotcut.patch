+void NewsDock::loadPhrases()
+{
+    QSettings s;
+    QStringList phrases = s.value(kPhrasesKey).toStringList();
+    if (phrases.isEmpty())
+        phrases << QStringLiteral("[정제본_영상취재]");
+    m_phraseCombo->clear();
+    m_phraseCombo->addItems(phrases);
+    const QString last = s.value(kPhraseKey, phrases.first()).toString();
+    m_phraseCombo->setCurrentText(last);
+}
+
+void NewsDock::savePhrases()
+{
+    QStringList phrases;
+    for (int i = 0; i < m_phraseCombo->count(); i++)
+        phrases << m_phraseCombo->itemText(i);
+    QSettings s;
+    s.setValue(kPhrasesKey, phrases);
+}
+
+void NewsDock::onSavePhrase()
+{
+    const QString text = m_phraseCombo->currentText().trimmed();
+    if (text.isEmpty())
+        return;
+    if (m_phraseCombo->findText(text) < 0)
+        m_phraseCombo->insertItem(0, text);
+    m_phraseCombo->setCurrentText(text);
+    savePhrases();
+}
+
+void NewsDock::onRemovePhrase()
+{
+    const int i = m_phraseCombo->findText(m_phraseCombo->currentText());
+    if (i >= 0)
+        m_phraseCombo->removeItem(i);
+    savePhrases();
+}
+
+QString NewsDock::outputBaseName() const
+{
+    QStringList parts;
+    if (m_dateCheck->isChecked())
+        parts << QDate::currentDate().toString("yyyyMMdd");
+    const QString phrase = m_phraseCombo->currentText().trimmed();
+    if (!phrase.isEmpty())
+        parts << phrase;
+    const QString title = m_titleEdit->text().trimmed();
+    if (!title.isEmpty())
+        parts << title;
+    QString name = parts.join(' ');
+    // Windows 파일명에 쓸 수 없는 문자 제거
+    static const QString bad = QStringLiteral("\\/:*?\"<>|");
+    for (const auto &c : bad)
+        name.remove(c);
+    return name.isEmpty() ? QStringLiteral("출력") : name;
+}
+
+void NewsDock::updateFileNamePreview()
+{
+    m_namePreview->setText(outputBaseName() + ".mxf");
+    QSettings s;
+    s.setValue(kDateKey, m_dateCheck->isChecked());
+    s.setValue(kPhraseKey, m_phraseCombo->currentText());
+    s.setValue(kOutDirKey, m_outDirEdit->text());
+}
