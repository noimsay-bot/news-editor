+// 분석 기준값 — E:\CONTENTS 실측(2026-10-15)으로 정함
+constexpr double kSpeechMinSeconds = 2.0;  // 채널1 음성 최소 길이
+constexpr double kSpeechMinRatio = 0.35;   // 분석 구간 중 음성 비율
+constexpr double kSpeechMinRmsDb = -45.0;  // 채널1 평균 레벨
+constexpr double kSpeechWindowSec = 30.0;  // 앞 30초만 분석
+constexpr int kShakeMinFrames = 120;       // 4초 이상 스케치만
+constexpr int kShakeWindowFrames = 60;     // 앞/뒤 2초 검사
+constexpr int kShakeMaxTrim = 45;          // 최대 1.5초까지만 자름
+constexpr int kShakeEdgeFrames = 6;        // 흔들림이 0.2초 안에 시작해야 녹화 흔들림으로 봄
+constexpr int kShakeCalmRun = 8;           // 이만큼 연속으로 안정되면 흔들림 끝
+constexpr int kMinRemainFrames = 90;       // 자른 뒤 최소 3초는 남김
+constexpr int kGridW = 32;
+constexpr int kGridH = 18;
+
+double median(QVector<float> v)
+{
+    if (v.isEmpty())
+        return 0.0;
+    std::sort(v.begin(), v.end());
+    return v[v.size() / 2];
+}
+
+QVector<float> parseMotion(const QByteArray &out)
+{
+    QVector<float> motion;
+    static const QRegularExpression re("YAVG=([0-9.]+)");
+    auto it = re.globalMatch(QString::fromLatin1(out));
+    while (it.hasNext())
+        motion << it.next().captured(1).toFloat();
+    return motion;
+}
+
+// 가장자리에서 시작한 흔들림이 끝나는 위치 (프레임 수). 없으면 0.
+int edgeShake(const QVector<float> &m, double thr)
+{
+    int firstShaky = -1;
+    for (int i = 0; i < std::min<int>(kShakeEdgeFrames, m.size()); i++) {
+        if (m[i] > thr) {
+            firstShaky = i;
+            break;
+        }
+    }
+    if (firstShaky < 0)
+        return 0;
+    int lastShaky = firstShaky;
+    int calm = 0;
+    for (int i = firstShaky; i < m.size() && i < kShakeMaxTrim + kShakeCalmRun; i++) {
+        if (m[i] > thr) {
+            lastShaky = i;
+            calm = 0;
+        } else if (++calm >= kShakeCalmRun) {
+            break;
+        }
+    }
+    // tblend 차이값 i는 프레임 i와 i+1 사이 → 흔들린 마지막 프레임 다음 + 여유 1프레임
+    return std::min(lastShaky + 2, kShakeMaxTrim);
+}
+
+} // namespace
+
+QString NewsAnalyzer::ffmpegPath()
+{
+    QDir dir(QCoreApplication::applicationDirPath());
+#ifdef Q_OS_WIN
+    const QString exe = "ffmpeg.exe";
+#else
+    const QString exe = "ffmpeg";
+#endif
+    if (dir.exists(exe))
+        return dir.absoluteFilePath(exe);
+    const QString found = QStandardPaths::findExecutable("ffmpeg");
+    return found.isEmpty() ? exe : found;
+}
+
+QByteArray NewsAnalyzer::run(const QStringList &args, int timeoutMs, bool stdoutOnly)
+{
+    QProcess p;
+    p.setProcessChannelMode(stdoutOnly ? QProcess::SeparateChannels : QProcess::MergedChannels);
+    p.start(ffmpegPath(), QStringList{"-hide_banner", "-nostats"} + args);
+    if (!p.waitForStarted(5000))
+        return {};
+    p.closeWriteChannel();
+    QByteArray out;
+    QElapsedTimer timer;
+    timer.start();
+    while (p.state() != QProcess::NotRunning) {
+        p.waitForReadyRead(1000);
+        out += p.readAllStandardOutput();
+        if (timer.elapsed() > timeoutMs) {
+            p.kill();
+            p.waitForFinished(2000);
+            break;
+        }
+    }
+    out += p.readAllStandardOutput();
+    return out;
+}
+
+void NewsAnalyzer::analyzeSpeech(const QString &ch1Path, double shotSeconds, ShotAnalysis &out)
+{
+    const double window = std::min(shotSeconds, kSpeechWindowSec);
+    const QByteArray log = run({"-t",
+                                QString::number(window, 'f', 2),
+                                "-i",
+                                ch1Path,
+                                "-af",
+                                "highpass=f=200,lowpass=f=3500,astats=metadata=0,"
+                                "silencedetect=n=-40dB:d=0.35",
+                                "-f",
+                                "null",
+                                "-"},
+                               60000,
+                               false);
+    const QString s = QString::fromUtf8(log);
+    double silence = 0.0;
+    static const QRegularExpression reSil("silence_duration: ([0-9.]+)");
+    auto it = reSil.globalMatch(s);
+    while (it.hasNext())
+        silence += it.next().captured(1).toDouble();
+    static const QRegularExpression reRms("RMS level dB: (-?[0-9.]+|-inf)");
+    auto m = reRms.match(s);
+    out.ch1RmsDb = (m.hasMatch() && m.captured(1) != "-inf") ? m.captured(1).toDouble() : -100.0;
+    out.voicedSeconds = std::max(0.0, window - silence);
+    out.voicedRatio = window > 0 ? out.voicedSeconds / window : 0.0;
+    out.isSync = out.voicedSeconds >= kSpeechMinSeconds && out.voicedRatio >= kSpeechMinRatio
+                 && out.ch1RmsDb >= kSpeechMinRmsDb;
+}
+
+void NewsAnalyzer::computeTrim(const QVector<float> &headMotion,
+                               const QVector<float> &tailMotion,
+                               int shotFrames,
+                               int &head,
+                               int &tail)
+{
+    head = tail = 0;
+    if (shotFrames < kShakeMinFrames)
+        return;
+    const double base = median(headMotion + tailMotion);
+    const double thr = std::max(2.0, base * 3.0);
+    head = edgeShake(headMotion, thr);
+    QVector<float> rev(tailMotion.rbegin(), tailMotion.rend());
+    tail = edgeShake(rev, thr);
+    // 남는 길이가 너무 짧으면 비율대로 줄인다.
+    const int maxTotal = std::max(0, shotFrames - kMinRemainFrames);
+    if (head + tail > maxTotal) {
+        const double k = (head + tail) > 0 ? double(maxTotal) / (head + tail) : 0.0;
+        head = int(head * k);
+        tail = int(tail * k);
+    }
+}
+
+void NewsAnalyzer::analyzeShake(const QString &proxyPath, int shotFrames, ShotAnalysis &out)
+{
+    out.trimHead = out.trimTail = 0;
+    if (shotFrames < kShakeMinFrames || !QFileInfo::exists(proxyPath))
+        return;
+    const QString filter = "scale=160:90,format=gray,tblend=all_mode=difference,signalstats,"
+                           "metadata=print:key=lavfi.signalstats.YAVG:file=-";
+    const QString secs = QString::number(kShakeWindowFrames * 1001.0 / 30000.0, 'f', 3);
+    const auto headMotion = parseMotion(
+        run({"-t", secs, "-i", proxyPath, "-an", "-vf", filter, "-f", "null", "-"}, 30000, true));
+    const auto tailMotion = parseMotion(
+        run({"-sseof", "-" + secs, "-i", proxyPath, "-an", "-vf", filter, "-f", "null", "-"},
+            30000,
+            true));
+    computeTrim(headMotion, tailMotion, shotFrames, out.trimHead, out.trimTail);
+}
+
+void NewsAnalyzer::analyzeColor(const QString &proxyPath, double shotSeconds, ShotAnalysis &out)
+{
+    out.wbNeeded = false;
+    out.exposureNeeded = false;
+    if (!QFileInfo::exists(proxyPath))
+        return;
+    // 샷 전체에서 고르게 8프레임 (긴 샷은 앞 60초 안에서)
+    const double span = std::min(std::max(shotSeconds, 1.0), 60.0);
+    const QString vf = QStringLiteral("fps=%1,scale=%2:%3:flags=area,format=rgb24")
+                           .arg(8.0 / span, 0, 'f', 4)
+                           .arg(kGridW)
+                           .arg(kGridH);
+    const QByteArray raw = run({"-t",
+                                QString::number(span, 'f', 2),
+                                "-i",
+                                proxyPath,
+                                "-an",
+                                "-vf",
+                                vf,
+                                "-f",
+                                "rawvideo",
+                                "-"},
+                               30000,
+                               true);
+    const int frameBytes = kGridW * kGridH * 3;
+    const int frames = raw.size() / frameBytes;
+    if (frames <= 0)
+        return;
+
+    // 셀별 평균 휘도, 그레이월드 평균
+    QVector<double> luma(kGridW * kGridH, 0.0);
+    double sr = 0, sg = 0, sb = 0;
+    long count = 0;
+    const auto *d = reinterpret_cast<const unsigned char *>(raw.constData());
+    for (int f = 0; f < frames; f++) {
+        for (int i = 0; i < kGridW * kGridH; i++) {
+            const int r = d[f * frameBytes + i * 3];
+            const int g = d[f * frameBytes + i * 3 + 1];
+            const int b = d[f * frameBytes + i * 3 + 2];
+            const double y = 0.2126 * r + 0.7152 * g + 0.0722 * b;
+            luma[i] += y / frames;
+            if (y > 40 && y < 220 && std::max({r, g, b}) < 250) {
+                sr += r;
+                sg += g;
+                sb += b;
+                count++;
+            }
+        }
+    }
+
+    // 자동 화이트밸런스: 그레이월드. 색 치우침이 4% 이상일 때만, 70%만 보정해 과보정 방지.
+    if (count > 50) {
+        sr /= count;
+        sg /= count;
+        sb /= count;
+        const double mean = (sr + sg + sb) / 3.0;
+        const double dev = std::max({std::abs(sr - mean), std::abs(sg - mean), std::abs(sb - mean)})
+                           / mean;
+        if (dev > 0.04 && dev < 0.35) {
+            auto neutral = [&](double c) {
+                return std::clamp(int(std::lround(127.0 * (mean + (c - mean) * 0.7) / mean)), 0, 255);
+            };
+            out.wbNeeded = true;
+            out.wbNeutral = QColor(neutral(sr), neutral(sg), neutral(sb));
+        }
+    }
+
+    // 인물 부분 노출: 화면 중앙 아래쪽(인터뷰 피사체 자리)이 바깥보다 확연히 어두우면
+    auto cell = [&](int x, int y) { return luma[y * kGridW + x]; };
+    double centerSum = 0, outerSum = 0;
+    int centerN = 0, outerN = 0;
+    for (int y = 0; y < kGridH; y++) {
+        for (int x = 0; x < kGridW; x++) {
+            const bool center = x >= 10 && x < 22 && y >= 4;
+            (center ? centerSum : outerSum) += cell(x, y);
+            (center ? centerN : outerN)++;
+        }
+    }
+    const double lc = centerSum / centerN;
+    const double lo = outerSum / outerN;
+    out.subjectLuma = lc;
+    out.backgroundLuma = lo;
+    if (lo - lc >= 28.0 && lc <= 120.0) {
+        const double darkThr = lc + (lo - lc) * 0.4;
+        int x0 = kGridW, y0 = kGridH, x1 = -1, y1 = -1, n = 0;
+        for (int y = 2; y < kGridH; y++) {
+            for (int x = 6; x < kGridW - 6; x++) {
+                if (cell(x, y) < darkThr) {
+                    x0 = std::min(x0, x);
+                    y0 = std::min(y0, y);
+                    x1 = std::max(x1, x);
+                    y1 = std::max(y1, y);
+                    n++;
+                }
+            }
+        }
+        if (n >= 12) {
+            // 여유 1칸
+            x0 = std::max(0, x0 - 1);
+            y0 = std::max(0, y0 - 1);
+            x1 = std::min(kGridW - 1, x1 + 1);
+            y1 = std::min(kGridH - 1, y1 + 1);
+            out.subjectRect = QRectF(double(x0) / kGridW,
+                                     double(y0) / kGridH,
+                                     double(x1 - x0 + 1) / kGridW,
+                                     double(y1 - y0 + 1) / kGridH);
+            // 감마로 피사체 평균을 배경 쪽으로 끌어올림 (out = in^(1/g)), 노이즈 때문에 상한 1.8
+            const double target = std::min(lo * 0.85, lc + 60.0);
+            const double g = std::log(std::max(lc, 8.0) / 255.0) / std::log(target / 255.0);
+            out.exposureGamma = std::clamp(g, 1.0, 1.8);
+            out.exposureNeeded = out.exposureGamma >= 1.08;
+        }
+    }
+}
