+NewsDock::NewsDock(QWidget *parent)
+    : QDockWidget(tr("뉴스 원본"), parent)
+{
+    setObjectName("NewsDock");
+    auto panel = new QWidget(this);
+    panel->setObjectName("NewsPanel");
+    panel->setStyleSheet(kStyle);
+    auto layout = new QVBoxLayout(panel);
+    layout->setContentsMargins(10, 10, 10, 10);
+    layout->setSpacing(10);
+    layout->addWidget(buildCardSection());
+    layout->addWidget(buildShotSection(), 1);
+    layout->addWidget(buildExportSection());
+
+    auto scroll = new QScrollArea(this);
+    scroll->setWidgetResizable(true);
+    scroll->setFrameShape(QFrame::NoFrame);
+    scroll->setWidget(panel);
+    setWidget(scroll);
+    setMinimumWidth(460);
+
+    loadPhrases();
+    updateFileNamePreview();
+
+    // 자동 검증 모드: NEWS_SELFTEST=<CONTENTS 경로>, NEWS_SELFTEST_LIMIT=<샷 수>, NEWS_SELFTEST_EXPORT=<출력 파일>
+    const QString selftest = qEnvironmentVariable("NEWS_SELFTEST");
+    if (!selftest.isEmpty()) {
+        QTimer::singleShot(4000, this, [this, selftest]() {
+            show();
+            raise();
+            if (!loadCard(selftest)) {
+                LOG_ERROR() << "news selftest: load failed";
+                return;
+            }
+            const int limit = qEnvironmentVariableIntValue("NEWS_SELFTEST_LIMIT");
+            const QStringList only = qEnvironmentVariable("NEWS_SELFTEST_ONLY").split(",", Qt::SkipEmptyParts);
+            for (int i = 0; i < m_card.shots().size(); i++) {
+                const bool keep = only.isEmpty() ? (limit <= 0 || i < limit) : only.contains(m_card.shots()[i].name());
+                m_tree->topLevelItem(i)->setCheckState(ColName, keep ? Qt::Checked : Qt::Unchecked);
+                if (keep) {
+                    m_analysis[i] = computeShot(i);
+                    refreshRow(i);
+                    const auto &a = m_analysis[i];
+                    LOG_INFO() << "news selftest shot" << m_card.shots()[i].label() << "sync" << a.isSync
+                               << "voiced" << a.voicedSeconds << "trim" << a.trimHead << a.trimTail << "wb"
+                               << a.wbNeeded << a.wbNeutral.name() << "exposure" << a.exposureNeeded
+                               << a.exposureGamma << a.subjectRect;
+                }
+            }
+            const QString project = buildProjectFile();
+            LOG_INFO() << "news selftest project" << project;
+            if (project.isEmpty() || !MAIN.open(project))
+                return;
+            const QString target = qEnvironmentVariable("NEWS_SELFTEST_EXPORT");
+            if (!target.isEmpty()) {
+                QTimer::singleShot(3000, this, [target]() {
+                    LOG_INFO() << "news selftest export" << target
+                               << MAIN.encodeDock()->exportNewsXdcam(target);
+                });
+            }
+        });
+    }
+}
