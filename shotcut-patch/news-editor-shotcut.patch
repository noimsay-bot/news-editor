+bool NewsDock::loadCard(const QString &contentsDir)
+{
+    QString error;
+    if (!m_card.load(contentsDir, &error)) {
+        m_cardInfo->setText(error);
+        return false;
+    }
+    QSettings().setValue(kCardKey, contentsDir);
+    m_analysis = QVector<ShotAnalysis>(m_card.shots().size());
+    m_classification = QVector<int>(m_card.shots().size(), -1);
+    int spanned = 0;
+    double total = 0;
+    for (const auto &shot : m_card.shots()) {
+        total += shot.seconds();
+        if (shot.parts.size() > 1)
+            spanned++;
+    }
+    const auto &first = m_card.shots().first();
+    m_cardInfo->setText(tr("%1 · %2 · 샷 %3개 (연결 클립 %4개 합침) · 총 %5")
+                            .arg(first.model, first.codec)
+                            .arg(m_card.shots().size())
+                            .arg(spanned)
+                            .arg(formatDuration(total)));
+    populateShots();
+    m_analyzeButton->setEnabled(true);
+    m_arrangeButton->setEnabled(true);
+    m_status->setText(tr("자동 분석을 누르면 싱크/스케치 분류와 흔들림·색·노출을 분석합니다."));
+    return true;
+}
+
+void NewsDock::onLoad()
+{
+    if (m_busy)
+        return;
+    loadCard(m_pathEdit->text());
+}
+
+void NewsDock::populateShots()
+{
+    m_tree->clear();
+    const auto &shots = m_card.shots();
+    for (int i = 0; i < shots.size(); i++) {
+        auto item = new QTreeWidgetItem(m_tree);
+        item->setData(ColName, Qt::UserRole, i);
+        item->setFlags(item->flags() | Qt::ItemIsUserCheckable);
+        item->setCheckState(ColName, Qt::Checked);
+        QPixmap icon(m_card.iconPath(shots[i].name()));
+        if (!icon.isNull())
+            item->setIcon(ColName, QIcon(icon.scaled(48, 27, Qt::KeepAspectRatioByExpanding,
+                                                     Qt::SmoothTransformation)));
+        item->setText(ColName, shots[i].label());
+        item->setText(ColTimecode, shots[i].startTimecode);
+        item->setText(ColDuration, formatDuration(shots[i].seconds()));
+        if (shots[i].continuesOnOtherCard)
+            item->setToolTip(ColName, tr("다음 조각이 다른 카드에 있습니다."));
+        refreshRow(i);
+    }
+}
+
+bool NewsDock::isSync(int index) const
+{
+    if (m_classification[index] >= 0)
+        return m_classification[index] == 1;
+    return m_analysis[index].isSync;
+}
+
+void NewsDock::refreshRow(int index)
+{
+    auto item = m_tree->topLevelItem(index);
+    if (!item)
+        return;
+    const auto &a = m_analysis[index];
+    const bool known = a.done || m_classification[index] >= 0;
+    if (!known) {
+        item->setText(ColKind, QStringLiteral("—"));
+        item->setForeground(ColKind, QColor("#5c6270"));
+    } else if (isSync(index)) {
+        item->setText(ColKind, tr("싱크"));
+        item->setForeground(ColKind, QColor("#4fb4ff"));
+    } else {
+        item->setText(ColKind, tr("스케치"));
+        item->setForeground(ColKind, QColor("#a7aebb"));
+    }
+    if (a.done) {
+        item->setText(ColTrim,
+                      (a.trimHead || a.trimTail)
+                          ? QStringLiteral("%1 / %2").arg(a.trimHead).arg(a.trimTail)
+                          : QStringLiteral("—"));
+        item->setToolTip(ColTrim, tr("앞/뒤에서 자를 프레임 수"));
+        QStringList fixes;
+        if (a.wbNeeded)
+            fixes << tr("WB");
+        if (a.exposureNeeded)
+            fixes << tr("노출");
+        if (isSync(index))
+            fixes << tr("NR");
+        item->setText(ColFix, fixes.isEmpty() ? QStringLiteral("—") : fixes.join(" · "));
+        item->setToolTip(ColKind,
+                         tr("채널1 음성 %1초 (%2%), 레벨 %3 dB")
+                             .arg(a.voicedSeconds, 0, 'f', 1)
+                             .arg(int(a.voicedRatio * 100))
+                             .arg(a.ch1RmsDb, 0, 'f', 1));
+        QString fixTip;
+        if (a.wbNeeded)
+            fixTip += tr("화이트밸런스 중성색 %1\n").arg(a.wbNeutral.name());
+        if (a.exposureNeeded)
+            fixTip += tr("인물 영역 밝기 %1 → 배경 %2, 감마 %3")
+                          .arg(int(a.subjectLuma))
+                          .arg(int(a.backgroundLuma))
+                          .arg(a.exposureGamma, 0, 'f', 2);
+        item->setToolTip(ColFix, fixTip.trimmed());
+    }
+}
